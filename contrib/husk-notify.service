# Copy with husk-notify.timer to ~/.config/systemd/user/ after
# `cargo install --path .`, then `systemctl --user enable --now husk-notify.timer`.
[Unit]
Description=husk desktop notifications for due tasks

[Service]
Type=oneshot
ExecStart=%h/.cargo/bin/husk notify
# A hung notification daemon must not leave the unit activating forever.
TimeoutStartSec=30s
